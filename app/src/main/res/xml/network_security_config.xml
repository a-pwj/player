<?xml version="1.0" encoding="utf-8"?>
<!-- 局域网/SMB/HTTP 播放常见于本地视频源，允许明文；隐私空间的文件不走网络 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
